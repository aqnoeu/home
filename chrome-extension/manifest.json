{
  "manifest_version": 3,
  "name": "Home — Compartilhar aba",
  "version": "0.1.0",
  "description": "Compartilha somente a aba escolhida com o Home local, após clique.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:48731/*"
  ],
  "action": {
    "default_title": "Compartilhar com Home",
    "default_popup": "popup.html"
  },
  "optional_permissions": [
    "tabs"
  ]
}